#!/usr/bin/env python3.12
"""Launch the host-driven Android workflow CLI (package lives in ~/.ai/tools/android-workflow)."""

from __future__ import annotations

import runpy
import sys
from pathlib import Path

ROOT = Path.home() / ".ai" / "tools" / "android-workflow"
if not (ROOT / "android_workflow" / "cli.py").is_file():
    sys.stderr.write(f"error: android-workflow toolkit not found at {ROOT}\n")
    raise SystemExit(2)
sys.path.insert(0, str(ROOT))
sys.argv[0] = "android-workflow"
runpy.run_module("android_workflow.cli", run_name="__main__")
