#!/usr/bin/env python3
"""Stand-in for the GitHub CLI: answers what the android-workflow CLI asks and logs every call to gh-calls.jsonl
next to this file, so nothing reaches GitHub."""
import json, os, sys, time
args = sys.argv[1:]
log = os.path.join(os.path.dirname(os.path.abspath(__file__)), "gh-calls.jsonl")
with open(log, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"args": args, "at": time.time()}) + "\n")
joined = " ".join(args)
if args[:2] == ["auth", "status"]:
    print("github.com\n  ✓ Logged in to github.com account pat-dev (keyring)")
elif args[:2] == ["auth", "token"]:
    print("gho_FAKE")
elif args[:1] == ["api"] and "graphql" not in args:
    print("notes-team/notes-android")
elif "graphql" in args:
    n = int(time.time() * 1000) % 100000
    if "addPullRequestReviewThreadReply" in joined:
        print(json.dumps({"data": {"addPullRequestReviewThreadReply": {"comment": {"id": f"PRRC_reply{n}", "url": f"https://github.com/notes-team/notes-android/pull/42#discussion_r{n}"}}}}))
    elif "addComment" in joined:
        print(json.dumps({"data": {"addComment": {"commentEdge": {"node": {"id": f"IC_reply{n}", "url": f"https://github.com/notes-team/notes-android/pull/42#issuecomment-{n}"}}}}}))
    elif "resolveReviewThread" in joined or "mergePullRequest" in joined:
        print(json.dumps({"data": {}}))
    else:
        print(json.dumps({"data": {}}))
elif args[:2] == ["run", "rerun"]:
    pass
else:
    print("{}")
