{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/android-workflow/artifacts.schema.json",
  "title": "Android Workflow artifact contracts",
  "type": "object",
  "definitions": {
    "ticket-spec.json": {
      "type": "object",
      "required": [
        "schema_version",
        "ticket",
        "type",
        "reproduction",
        "acceptance_criteria",
        "surfaces",
        "complexity",
        "risk",
        "business_questions",
        "route"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ticket": {
          "type": "object"
        },
        "type": {
          "enum": [
            "bug",
            "feature",
            "chore"
          ]
        },
        "reproduction": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "type": "array"
        },
        "surfaces": {
          "type": "array"
        },
        "complexity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "business_questions": {
          "type": "array"
        },
        "route": {
          "type": "array"
        },
        "pr_template": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
